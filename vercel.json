{
  "version": 2,
  "builds": [
    {
      "src": "server/src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/src/server.js"
    },
    {
      "src": "/styles.css",
      "dest": "/client/styles.css"
    },
    {
      "src": "/app.js",
      "dest": "/client/app.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server/src/server.js"
    }
  ]
}
